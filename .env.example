# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string.
#
# Local development: this points at the private embedded PostgreSQL that
# `npm run dev` / `npm run db:setup` start automatically via
# scripts/with-pg.mjs (data lives in .local-pg/, nothing to install).
#
# Deployment (Cloud Run): set DATABASE_URL in the service config / Secret
# Manager to your managed PostgreSQL (e.g. a Neon or Cloud SQL connection
# string) instead. Any non-localhost URL is used as-is.
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:54329/opsmind"

# Optional: run `npm test` against an existing PostgreSQL server instead of
# the suite's own embedded instance. WARNING: the schema is force-reset.
# TEST_DATABASE_URL="postgres://user:password@host:5432/opsmind_test"

# Server-side only. Leave empty to use the labelled mock investigation provider.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Optional but recommended for a public demo. When set, POST /api/demo/reset
# requires this value in the x-demo-reset-token header. The reset button asks
# for it in the browser. Leave empty for one-click reset in local development.
DEMO_RESET_TOKEN=""
